# Copy to .env and adjust
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (production / normal use)
DATABASE_URL=postgres://alnoor:alnoor@localhost:5432/alnoor
# For quick local development without PostgreSQL, use instead:
# DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where daily backups are written by `manage.py backup`
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=90
